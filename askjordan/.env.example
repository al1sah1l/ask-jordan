MONGODB_URL=mongodb://dev:dev@127.0.0.1:27018/askjordan?authSource=admin

# auto: OpenAI with a key, prepared stories without one.
# live: try OpenAI; failures still use prepared stories.
# prepared: never call OpenAI (deterministic Alpha demo).
STORY_GENERATION_MODE=auto
OPENAI_API_KEY=
OPENAI_STORY_MODEL=gpt-4.1-mini
PUBLIC_ORIGIN=http://127.0.0.1:8080
# Password recovery. Leave both blank locally: the backend prints the reset link.
# On the deployed app, RESEND_FROM must be an address on askjordan.me, for example:
# RESEND_FROM=Ask Jordan <support@askjordan.me>
RESEND_API_KEY=
RESEND_FROM=
# auto: OpenAI with a key, prepared chapters without one; model failures fall back.
# prepared: no model calls. live: requires a key. disabled: refuses generation.
PROGRESSIVE_GENERATION_MODE=auto
